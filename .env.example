# ---- copy to .env; every value below works for `docker compose up` on a laptop -------------------
APP_NAME=VideoStudio
APP_ENV=dev                       # dev | prod
LOG_LEVEL=info
SECRET_KEY=change-me-to-a-long-random-string          # signs JWTs and email tokens
ADMIN_API_KEY=change-me-admin-key                      # X-Admin-Key header for /admin/*
WEB_ORIGIN=http://localhost:3000                       # CORS + links in emails
API_BASE_URL=http://localhost:8000
COOKIE_SECURE=0                                        # 1 in prod (HTTPS)

# ---- database (compose service names) ---------------------------------------------------------
POSTGRES_USER=videostudio
POSTGRES_PASSWORD=videostudio
POSTGRES_DB=videostudio
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://videostudio:videostudio@postgres:5432/videostudio
DATABASE_URL_SYNC=postgresql+psycopg://videostudio:videostudio@postgres:5432/videostudio
DATABASE_URL_TEST_SYNC=postgresql+psycopg://videostudio:videostudio@postgres:5432/videostudio_test

# ---- queue ---------------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=1
JOB_TIMEOUT_TRANSCRIBE_S=900
JOB_TIMEOUT_PLAN_S=300
JOB_TIMEOUT_RENDER_S=1800

# ---- object storage (MinIO in dev, any S3 in prod) ---------------------------------------------
S3_ENDPOINT_URL=http://minio:9000                      # internal (api/worker → minio)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100           # what the browser can reach (presigned URLs)
S3_REGION=us-east-1
S3_BUCKET=videos
S3_ACCESS_KEY=videostudio
S3_SECRET_KEY=videostudio-secret
S3_FORCE_PATH_STYLE=1
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ---- email ---------------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp                                    # smtp (Mailpit) | resend
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=VideoStudio <no-reply@videostudio.local>
RESEND_API_KEY=
MAILPIT_PORT=8025

# ---- payments ------------------------------------------------------------------------------------
PAYMENTS_PROVIDER=mock                                 # mock | lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_AGENCY=

# ---- engine / worker -----------------------------------------------------------------------------
WHISPER_MODEL=small                                    # image build arg; medium in prod
WORKER_SCRATCH_DIR=/jobs
RENDER_WORKERS=2                                       # parallel Chromium pages per render (memory: ~600 MB each at 1080p)
WATERMARK_PATH=/app/packages/shared/assets/watermark.png
TTS_PROVIDER=none                                      # none | openai | espeak (tests)
TTS_ENABLED=0                                          # feature flag for "paste a script"
VT_OFFLINE_RENDER=1

# ---- LLM (LiteLLM). Set at least one key; without any key the deterministic fallback planner is used.
PLANNER_MODE=llm                                       # llm | mock | fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
LLM_MODEL_PLANNER=                                     # default: anthropic/claude-sonnet-5 (if key) → openai/gpt-4o → ollama/qwen2.5:14b
LLM_MODEL_FAST=                                        # default: anthropic/claude-haiku-4-5-20251001
LLM_MODEL_VISION=
PLANNER_MODEL_FREE=
PLANNER_MODEL_PAID=
LLM_FALLBACK_CHAIN=
PLANNER_VISION_REVIEW=0
LLM_TIMEOUT_S=120

# ---- limits / features ---------------------------------------------------------------------------
RATE_LIMITS_ENABLED=1
GOOGLE_OAUTH_ENABLED=0
SENTRY_DSN=
API_PORT=8000
