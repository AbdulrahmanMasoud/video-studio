# ---- copy to .env; every value below works for `docker compose up` on a laptop -------------------
APP_NAME=VideoStudio
# dev | prod
APP_ENV=dev
LOG_LEVEL=info
# signs JWTs and email tokens
SECRET_KEY=change-me-to-a-long-random-string
# X-Admin-Key header for /admin/*
ADMIN_API_KEY=change-me-admin-key
# CORS + links in emails
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
# 1 in prod (HTTPS)
COOKIE_SECURE=0

# ---- database (compose service names) ---------------------------------------------------------
POSTGRES_USER=videostudio
POSTGRES_PASSWORD=videostudio
POSTGRES_DB=videostudio
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://videostudio:videostudio@postgres:5432/videostudio
DATABASE_URL_SYNC=postgresql+psycopg://videostudio:videostudio@postgres:5432/videostudio
DATABASE_URL_TEST_SYNC=postgresql+psycopg://videostudio:videostudio@postgres:5432/videostudio_test

# ---- queue ---------------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=1
JOB_TIMEOUT_TRANSCRIBE_S=900
JOB_TIMEOUT_PLAN_S=300
JOB_TIMEOUT_RENDER_S=1800

# ---- object storage (MinIO in dev, any S3 in prod) ---------------------------------------------
# internal (api/worker → minio)
S3_ENDPOINT_URL=http://minio:9000
# what the browser can reach (presigned URLs)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=videos
S3_ACCESS_KEY=videostudio
S3_SECRET_KEY=videostudio-secret
S3_FORCE_PATH_STYLE=1
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ---- email ---------------------------------------------------------------------------------------
# smtp (Mailpit) | resend
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=VideoStudio <no-reply@videostudio.local>
RESEND_API_KEY=
MAILPIT_PORT=8025

# ---- payments ------------------------------------------------------------------------------------
# mock | lemonsqueezy
PAYMENTS_PROVIDER=mock
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_AGENCY=

# ---- engine / worker -----------------------------------------------------------------------------
# image build arg; medium in prod
WHISPER_MODEL=small
WORKER_SCRATCH_DIR=/jobs
# parallel Chromium pages per render (memory: ~600 MB each at 1080p)
RENDER_WORKERS=2
WATERMARK_PATH=/app/packages/shared/assets/watermark.png
# none | openai | espeak (tests)
TTS_PROVIDER=none
# feature flag for "paste a script"
TTS_ENABLED=0
VT_OFFLINE_RENDER=1

# ---- LLM (LiteLLM). Set at least one key; without any key the deterministic fallback planner is used.
# llm | mock | fallback
PLANNER_MODE=llm
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
# default: anthropic/claude-sonnet-5 (if key) → openai/gpt-4o → ollama/qwen2.5:14b
LLM_MODEL_PLANNER=
# default: anthropic/claude-haiku-4-5-20251001
LLM_MODEL_FAST=
LLM_MODEL_VISION=
PLANNER_MODEL_FREE=
PLANNER_MODEL_PAID=
LLM_FALLBACK_CHAIN=
PLANNER_VISION_REVIEW=0
LLM_TIMEOUT_S=120

# ---- limits / features ---------------------------------------------------------------------------
RATE_LIMITS_ENABLED=1
GOOGLE_OAUTH_ENABLED=0
SENTRY_DSN=
API_PORT=8000
WEB_PORT=3000

# ---- production (docker-compose.prod.yml) --------------------------------------------------------
# public domain served by Caddy (TLS via Let's Encrypt) and the ACME account email
DOMAIN=
ACME_EMAIL=
# nightly pg_dump → s3://$S3_BUCKET/backups (hour in UTC, retention in days)
BACKUP_HOUR_UTC=03
BACKUP_KEEP_DAYS=14
# force draft (half-resolution) renders: load tests and cheap environments only
RENDER_DRAFT=0
# browser error reporting (public DSN) for the web app; SENTRY_DSN above covers api + worker
NEXT_PUBLIC_SENTRY_DSN=
